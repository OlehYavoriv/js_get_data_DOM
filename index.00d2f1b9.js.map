'use strict';
var population = document.querySelectorAll('.population');
var totalPopulation = document.querySelector('.total-population');
var averagePopulation = document.querySelector('.average-population');
var numbers = [];
for(var i = 0; i < population.length; i++){
    var text = population[i].textContent;
    var convertToNumber = Number(text.replace(/,/g, ''));
    numbers.push(convertToNumber);
}
var totalSum = numbers.reduce(function(sum, current) {
    return sum + current;
}, 0);
var average = totalSum / numbers.length;
var formatNumber = function(num) {
    return num.toLocaleString('en-US');
};
totalPopulation.innerHTML = formatNumber(totalSum);
averagePopulation.innerHTML = formatNumber(Math.round(average));

